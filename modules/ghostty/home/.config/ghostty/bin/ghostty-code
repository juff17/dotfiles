#!/usr/bin/env bash
# Alt+E (layout.conf) runs this: opens the current tab's repo in VS Code. A
# tab in a git worktree opens that worktree, not the main checkout, since
# --show-toplevel names the worktree. Outside git it opens the tab's folder.
# $1 is the tab session to read: the window's, or the one the hub opened.

source "$(dirname "$(readlink -f "$0")")/ghostty-lib.sh"

dir=$(tmux -L "$TABS_SOCKET" display -p -t "=$1:" '#{pane_current_path}' 2>/dev/null)
if [[ -z $dir ]]; then
  layout display-message "No tab to open in VS Code."
  exit 1
fi
root=$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null) || root=$dir
if ! command -v code >/dev/null; then
  layout display-message "VS Code (code) isn't installed."
  exit 1
fi
# Its own session, so VS Code outlives the tmux job that started it.
setsid -f code "$root" >/dev/null 2>&1
