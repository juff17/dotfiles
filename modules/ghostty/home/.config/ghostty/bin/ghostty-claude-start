#!/usr/bin/env bash
# Claude Code SessionStart hook (on startup and resume): points the window's
# viewer at the folder Claude started in. A running yazi (Files) goes there
# now; otherwise Files opens there next time. It never moves focus, so you can
# type into Claude straight away. If the window has no viewer (you closed it)
# and the workspace shows, it opens one, which holds focus for a second (see
# open_viewer).
# Does nothing outside the Ghostty layout. SessionStart adds anything printed
# to Claude's context, so it stays silent.

[[ ${TMUX:-} == */"ghostty,"* ]] || exit 0
source "$(dirname "$(readlink -f "$0")")/ghostty-lib.sh"

session=$(tmux display -p '#S' 2>/dev/null)
win=${session#ghostty-}
[[ $win =~ ^[0-9]+$ ]] || exit 0

# Diff, Diagrams and the agent hub need Node.js, and the hub needs claude,
# which Ghostty's own PATH usually lacks, so they read where they are from here.
cache=${XDG_CACHE_HOME:-$HOME/.cache}/ghostty-layout
if node=$(command -v node); then
  mkdir -p "$cache" && readlink -f "$node" >"$cache/node"
fi
# Not resolved: claude's link points at one version, which an update removes.
if claude=$(command -v claude); then
  mkdir -p "$cache" && echo "$claude" >"$cache/claude"
fi

# One hook at a time per window: Claude can start several sessions at once
# (agents in worktrees), and each would otherwise see no viewer and open one.
if lock_dir=$(state_dir); then
  exec 9>"$lock_dir/claude-start-$win.lock" && flock -w 10 9
fi

# -s: every window of the session. The viewer lives in the workspace window,
# which isn't the current one while the hub shows.
viewer=$(layout list-panes -s -t "layout-$win" -F '#{pane_id} #{pane_start_command}' 2>/dev/null |
  awk '/ghostty-viewer/ { print $1; exit }')
if [[ -z $viewer ]]; then
  # Only while the workspace shows. yazi's terminal questions are answered to
  # the focused pane, and with the hub in front that's the hub, which reads
  # the answer's letters as its keys (o and q switch to the workspace).
  tabs=$(layout show -t "layout-$win" -v @tabs 2>/dev/null)
  [[ -n $tabs && $(layout display -p -t "$tabs" '#{window_active}' 2>/dev/null) == 1 ]] &&
    open_viewer "$win" "$PWD"
  exit 0
fi

dir_file=$(viewer_dir_file "$win")
mkdir -p "$(dirname "$dir_file")" && echo "$PWD" >"$dir_file"
ya=$(command -v ya || command -v yazi.ya) &&
  "$ya" emit-to "$(viewer_id "$win")" cd "$PWD" >/dev/null 2>&1
exit 0
