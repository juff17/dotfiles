#!/usr/bin/env bash
# What babysitters proposed (viewer/approvals-view.mjs) in a tmux popup over
# the whole window, from Alt+A (layout.conf) or the tray's Edit and Review
# buttons (hub/tray.mjs). Alt+A, Esc or q closes it. The popup's border is
# peach, as the tray draws things that need you.
#   ghostty-approvals <client> [id]     open it on that tmux client, on that proposal
#   ghostty-approvals --panel [id]      what runs inside the popup

source "$(dirname "$(readlink -f "$0")")/ghostty-lib.sh"

if [[ $1 == --panel ]]; then
  node=$(command -v node || cat "${XDG_CACHE_HOME:-$HOME/.cache}/ghostty-layout/node" 2>/dev/null)
  if [[ -z $node ]]; then
    echo "Approvals needs Node.js, and none was found."
    read -rsn1 -p "Press any key to close."
    exit 1
  fi
  exec "$node" "$GHOSTTY_CONF/viewer/approvals-view.mjs" "${2:-}"
fi

client=$1
layout display-popup -c "$client" -E -w 70% -h 85% -b rounded -S "fg=#fab387" -s "bg=#1e1e2e" \
  "$(printf '%q ' "$GHOSTTY_CONF/bin/ghostty-approvals" --panel "${2:-}")"
