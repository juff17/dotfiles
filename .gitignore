# installer backups (conflicting files moved here during install)
.dotfiles-backup/
*.bak.*

# machine-local Claude settings (never committed)
.claude/settings.local.json

home/.claude/skills/standup-prep/config.yaml
home/.claude/skills/slack-digest/config.yaml

# python runtime artifacts (skills are folder-symlinked into ~/.claude, so these
# get created inside the repo when a skill's scripts run)
__pycache__/
*.pyc

# KDE runtime state (config files are live-symlinked into ~/.config, so KDE
# rewrites them mid-session — these hold only per-machine/runtime state, not
# portable config: notification "Seen" flags, panel geometry, migration lists,
# recent-file paths)
home/.config/plasmanotifyrc
home/.config/plasmashellrc
home/.config/flameshotrc

# KDE files with no actual customization (only defaults / migration markers /
# first-run flags) — nothing worth versioning
home/.config/powermanagementprofilesrc
home/.config/plasma-localerc
home/.config/yakuakerc

# Kate editor — not used on this setup, don't track its config
home/.config/katevirc
home/.config/kate/
